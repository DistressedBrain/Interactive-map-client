<Window
    x:Class="InteractiveMap.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:InteractiveMap">

    <Grid x:Name="Root" Background="{StaticResource AppBgBrush}" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <Style x:Key="FlatButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10,6" />
            </Style>
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFocusSearch" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ title bar: pane toggle, game, worlds, search, settings ============ -->
        <Grid x:Name="TitleRow" Grid.Row="0"
              Background="{StaticResource PaneBgBrush}"
              BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="48" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>

            <Button x:Name="PaneToggle" Grid.Column="0" Style="{StaticResource FlatButton}"
                    Margin="6,0,2,0" Width="40" Height="36" Padding="0"
                    Click="OnPaneToggle" ToolTipService.ToolTip="Show or hide filters">
                <FontIcon Glyph="&#xE700;" FontSize="16" />
            </Button>

            <!-- the game: its icon, and its name to the right -->
            <Button x:Name="GameButton" Grid.Column="1" Style="{StaticResource FlatButton}"
                    Height="40" Padding="6,0,10,0" Margin="0,0,6,0"
                    ToolTipService.ToolTip="Switch game">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Background="{StaticResource LogoPlateBrush}" CornerRadius="7"
                            Width="32" Height="32">
                        <Grid>
                            <TextBlock x:Name="GameInitials" Foreground="White" FontWeight="Bold" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="GameLogo" Stretch="UniformToFill" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="GameName" Text="Interactive Map" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <FontIcon Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center"
                              Foreground="{StaticResource TextDimBrush}" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout x:Name="GameFlyout" Placement="BottomEdgeAlignedLeft">
                        <StackPanel x:Name="GameList" MinWidth="300" Spacing="2" />
                    </Flyout>
                </Button.Flyout>
            </Button>

            <ScrollViewer x:Name="TabsScroller" Grid.Column="2"
                          HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Tabs" Orientation="Horizontal" />
            </ScrollViewer>

            <!-- the only part of the bar that drags the window -->
            <Border x:Name="DragRegion" Grid.Column="3" Background="Transparent" />

            <AutoSuggestBox x:Name="SearchBox" Grid.Column="4" Width="280" VerticalAlignment="Center"
                            PlaceholderText="Search bosses, places, materials"
                            QueryIcon="Find" UpdateTextOnSelect="False"
                            TextChanged="OnSearchText" QuerySubmitted="OnSearchSubmitted">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="0,4">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Sub}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>

            <Button x:Name="SettingsButton" Grid.Column="5" Style="{StaticResource FlatButton}"
                    Margin="6,0,0,0" Width="40" Height="36" Padding="0"
                    ToolTipService.ToolTip="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel Width="260" Spacing="6">
                            <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" />
                            <RadioButtons x:Name="ThemeRadios" Header="Style" SelectionChanged="OnThemeChanged">
                                <x:String>Dark</x:String>
                                <x:String>Light</x:String>
                                <x:String>Dim</x:String>
                            </RadioButtons>
                            <TextBlock Text="Map data" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock x:Name="DataPathText" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Foreground="{StaticResource TextDimBrush}" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- ============ filters + map ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PaneColumn" Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="Pane" Grid.Column="0"
                    Background="{StaticResource PaneBgBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="12,10,12,16">
                        <ToggleSwitch x:Name="HideSwitch" OnContent="Tap pins to hide them" OffContent="Tap pins to hide them"
                                      Toggled="OnHideToggled" />
                        <ToggleSwitch x:Name="NamesSwitch" OnContent="Place names" OffContent="Place names" IsOn="True"
                                      Toggled="OnNamesToggled" />
                        <StackPanel x:Name="HiddenLine" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                            <TextBlock x:Name="HiddenText" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{StaticResource TextDimBrush}" />
                            <HyperlinkButton Content="Show them again" Click="OnShowHidden" Padding="4,2" />
                        </StackPanel>
                        <StackPanel x:Name="Filters" Margin="0,6,0,0" />
                        <TextBlock Text="Every position, name and icon comes from the game's own files."
                                   FontSize="12" TextWrapping="Wrap" Margin="4,16,4,0"
                                   Foreground="{StaticResource TextDimBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1">
                <local:MapCanvas x:Name="Map" />

                <ProgressRing x:Name="Busy" IsActive="False" Width="48" Height="48" />
                <TextBlock x:Name="Message" Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="520"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />

                <!-- pin details -->
                <Border x:Name="Card" Visibility="Collapsed" Width="340" Margin="16"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="{StaticResource CardBgBrush}"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <ScrollViewer x:Name="CardScroll" VerticalScrollBarVisibility="Auto" MaxHeight="520">
                            <StackPanel Padding="16,14,16,16" Spacing="8">
                                <Grid ColumnSpacing="12" Margin="0,0,28,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="52" Height="52" CornerRadius="6" Background="{StaticResource LogoPlateBrush}">
                                        <Grid>
                                            <Ellipse x:Name="CardPip" Width="14" Height="14" />
                                            <Image x:Name="CardIcon" Margin="5" Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="CardKind" FontSize="12" CharacterSpacing="60"
                                                   Foreground="{StaticResource TextDimBrush}" />
                                        <TextBlock x:Name="CardName" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="CardPlace" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextDimBrush}" />
                                <TextBlock x:Name="CardDesc" FontSize="13.5" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <StackPanel x:Name="CardLines" Spacing="2" />
                                <Button Content="Hide this pin" Click="OnCardHide" Margin="0,4,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                        <Button Style="{StaticResource FlatButton}" Width="32" Height="32" Padding="0" Margin="6"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Click="OnCardClose" ToolTipService.ToolTip="Close">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>
                </Border>

                <!-- zoom -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16"
                        Background="{StaticResource CardBgBrush}"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <Button Style="{StaticResource FlatButton}" Width="40" Height="38" Padding="0"
                                Click="OnZoomIn" ToolTipService.ToolTip="Zoom in">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Width="40" Height="38" Padding="0"
                                Click="OnZoomOut" ToolTipService.ToolTip="Zoom out">
                            <FontIcon Glyph="&#xE738;" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Width="40" Height="38" Padding="0"
                                Click="OnZoomFit" ToolTipService.ToolTip="Show the whole map">
                            <FontIcon Glyph="&#xE9A6;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Border>

                <InfoBar x:Name="Toast" IsOpen="False" IsIconVisible="False" Severity="Informational"
                         HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24">
                    <InfoBar.ActionButton>
                        <Button x:Name="ToastUndo" Content="Undo" Click="OnToastUndo" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </Grid>
        </Grid>
    </Grid>
</Window>
