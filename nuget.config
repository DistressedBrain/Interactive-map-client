<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- An optional folder of packages fetched ahead of time, used in addition
         to nuget.org: large downloads dropped on a slow line, and NuGet cannot
         resume them. -->
    <add key="local" value="%USERPROFILE%\.nuget\localfeed" />
  </packageSources>
</configuration>
