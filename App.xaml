<Application
    x:Class="InteractiveMap.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <!-- The app's own surfaces. Theme.Apply() changes the Color of these
                 same brush objects, so everything that uses them follows at once. -->
            <SolidColorBrush x:Key="AppBgBrush" Color="#0B0E11" />
            <SolidColorBrush x:Key="PaneBgBrush" Color="#12161B" />
            <SolidColorBrush x:Key="CardBgBrush" Color="#171C22" />
            <SolidColorBrush x:Key="StrokeBrush" Color="#262D36" />
            <SolidColorBrush x:Key="HoverBrush" Color="#1E252D" />
            <SolidColorBrush x:Key="TextBrush" Color="#F2F4F6" />
            <SolidColorBrush x:Key="TextDimBrush" Color="#9AA4AF" />
            <SolidColorBrush x:Key="AccentBrush" Color="#F2C14E" />
            <!-- Logos are light wordmarks, so they always sit on a dark plate. -->
            <SolidColorBrush x:Key="LogoPlateBrush" Color="#0B0E11" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
